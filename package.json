{
  "name": "telegram-nft-smart-money-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_OPTIONS=\"--max-old-space-size=256\" NODE_ENV=production tsx server.ts",
    "start:bot": "NODE_OPTIONS=\"--max-old-space-size=192\" tsx src/bot/standalone.ts",
    "test": "tsx test/run_all_tests.ts",
    "zip": "tsx scripts/create_zip.ts",
    "clean": "rm -rf dist server.js *.zip data/test_*.sqlite*",
    "clean:cache": "npm cache clean --force",
    "postinstall": "npm cache clean --force 2>/dev/null || true",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "archiver": "^8.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "telegraf": "^4.16.3",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
